# ==============================================================================
# DEVSU BANKING - CONFIGURACIÓN DE ENTORNO LOCAL (.env.example)
# Copia este archivo como '.env' en la raíz del proyecto para personalizar
# tus credenciales de desarrollo local.
# ==============================================================================

# Configuración de Base de Datos (PostgreSQL)
# Dos bases lógicas independientes, una por microservicio (Database-per-Service)
POSTGRES_DB_CLIENTES=devsu_clientes
POSTGRES_DB_CUENTAS=devsu_cuentas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devsu_db_secret_pass
POSTGRES_PORT=5432

# Configuración de Mensajería Asíncrona (RabbitMQ)
RABBITMQ_DEFAULT_USER=devsu_admin
RABBITMQ_DEFAULT_PASS=devsu_rabbit_secret_pass
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
