		{
			"name": "F2 / F3 - Movimientos",
			"item": [
				{
					"name": "Registrar Retiro Valido (-575.00)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Saldo remanente es 1425.00\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.saldo).to.eql(1425.00);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
