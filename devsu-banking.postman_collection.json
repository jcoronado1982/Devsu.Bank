				{
					"name": "EB-01 Retiro Mayor al Saldo (Saldo no disponible)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"pm.test(\"Mensaje exacto 'Saldo no disponible'\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.mensaje || jsonData.detail || pm.response.text()).to.include(\"Saldo no disponible\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"valor\": -5000.00\n}"
						},
						"url": {
							"raw": "{{servidor}}:{{puerto_cuenta}}/movimientos",
							"host": [
								"{{servidor}}"
							],
