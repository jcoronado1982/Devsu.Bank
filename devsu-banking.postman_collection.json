{
	"info": {
		"_postman_id": "8a3f8901-4467-4284-9bc0-884877196011",
		"name": "Devsu Banking Microservices (.NET 9)",
		"description": "Colección oficial de pruebas de integración de endpoints REST para el reto de Devsu (F1 a F4). Cumple la convención de variables {{servidor}} y {{puerto}} con aserciones automáticas para Newman CLI.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "F1 - Clientes",
			"item": [
				{
					"name": "Crear Cliente (Jose Lema)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Cliente contiene nombre y no expone contrasena\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.nombre).to.eql(\"Jose Lema\");",
									"    pm.expect(jsonData.contrasena).to.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"Masculino\",\n  \"edad\": 35,\n  \"identificacion\": \"1234567890\",\n  \"direccion\": \"Otavalo sn y principal\",\n  \"telefono\": \"098254785\",\n  \"contrasena\": \"1234\",\n  \"estado\": true\n}"
						},
						"url": {
							"raw": "{{servidor}}:{{puerto_cliente}}/clientes",
							"host": [
								"{{servidor}}"
							],
							"port": "{{puerto_cliente}}",
							"path": [
								"clientes"
							]
						}
					},
					"response": []
				},
				{
					"name": "Listar Clientes",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Retorna lista no vacia de clientes\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\").that.is.not.empty;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{servidor}}:{{puerto_cliente}}/clientes",
							"host": [
								"{{servidor}}"
							],
							"port": "{{puerto_cliente}}",
							"path": [
								"clientes"
							]
						}
					},
					"response": []
				}
			]
		},
